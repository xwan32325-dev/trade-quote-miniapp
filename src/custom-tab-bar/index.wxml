<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tabbar-text">{{item.text}}</text>
    <view class="tabbar-underline" wx:if="{{selected === index}}"></view>
  </view>
</view>
